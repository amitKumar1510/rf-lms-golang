# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/frontend/node_modules
/.pnp
.pnp.js

# testing
/frontend/coverage

# production
/frontend/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Ignore virtual environments
/backend-main/venv/
/backend-main/__pypackages__/
/backend-main/env/
/backend-main/.venv/

# Some IDEs also create specific folders for virtual environments
# .idea/
/backend-main/.vscode/

# Ignore Python bytecode files
*.pyc
*.pyo
*.pyd
/backend-main/__pycache__/
*.py[cod]

# Ignore cache directories
/backend-main/__pycache__/
/backend-main/.cache/

# Ignore logs and databases
*.log
/backend-main/*.sqlite
/backend-main/*.sqlite3

# Ignore environment variable files
.env
.env.*

# Ignore coverage reports
.coverage
*.coveragerc

# Ignore distribution / packaging files
/backend-main/dist/
/backend-main/build/
/backend-main/eggs/
/backend-main/*.egg-info/
*.egg

# Ignore test-related files
/backend-main/nosetests.xml
/backend-main/coverage.xml
*.coveragerc

# Ignore mypy and pylint configuration files
/backend-main/mypy.ini
/backend-main/pylint.rc

# Ignore temporary or backup files
/backend-main/*~
/backend-main/*.swp
/backend-main/*.bak
/backend-main/*.tmp

# Ignore IDE or editor specific files
/backend-main/.idea/
/backend-main/.vscode/

# Ignore system-specific files
/backend-main/.DS_Store
/backend-main/Thumbs.db

#Ignore .vscode
/backend-main/.vscode/

/backend-main/test.db
/backend-main/alembic.ini

# Ignore Alembic because now it not used
/backend-main/alembic/

/backend-main/firebase_credentials.json


